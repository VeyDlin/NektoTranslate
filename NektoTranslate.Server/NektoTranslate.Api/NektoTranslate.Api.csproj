<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>NektoTranslate.Api</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="logs\**" />
		<None Remove="logs\**" />
	</ItemGroup>

	<!--
		The client build writes here on publish, below. It never exists during an ordinary "dotnet
		build" or "dotnet test", so the default item glob below finds nothing then; excluded anyway
		so a folder left over from an earlier publish is not swept into a Debug build.
	-->
	<ItemGroup>
		<Content Remove="wwwroot\**" />
		<None Remove="wwwroot\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NektoTranslate.Core\NektoTranslate.Core.csproj" />
	</ItemGroup>

	<!--
		Site parsers ship beside the binary rather than embedded, so a broken site can be fixed by
		editing one file. The layout under "parsers" is what ParserScriptStore expects.
	-->
	<ItemGroup>
		<Content Include="..\vendor\WebToEpub\**\*.js"
		         Link="parsers\%(RecursiveDir)%(Filename)%(Extension)"
		         CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\vendor\WebToEpub\LICENSE.md"
		         Link="parsers\LICENSE.md"
		         CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mediator.SourceGenerator">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<NektoClientDirectory>$(MSBuildThisFileDirectory)..\..\NektoTranslate.Client\</NektoClientDirectory>
		<!-- The shell's own "is this on PATH" question, which is spelled differently per platform. -->
		<NektoNpmProbe Condition="$([MSBuild]::IsOSPlatform('Windows'))">where npm</NektoNpmProbe>
		<NektoNpmProbe Condition="!$([MSBuild]::IsOSPlatform('Windows'))">which npm</NektoNpmProbe>
	</PropertyGroup>

	<!--
		The client compiles into wwwroot only on publish - running "npm ci" and a Vite build on
		every "dotnet build" or "dotnet test" would slow down the two commands a working session
		actually spends its time on, for a change that never touched the client. SkipClientBuild is
		for the one case that still needs a publish without this: a wwwroot already built by hand.
	-->
	<Target Name="BuildClient" BeforeTargets="PrepareForPublish" Condition="'$(SkipClientBuild)' != 'true'">
		<Exec Command="$(NektoNpmProbe)" ContinueOnError="WarnAndContinue" StandardOutputImportance="Low" StandardErrorImportance="Low">
			<Output TaskParameter="ExitCode" PropertyName="NektoNpmCheckExitCode" />
		</Exec>

		<Error
			Condition="'$(NektoNpmCheckExitCode)' != '0'"
			Text="Publishing needs Node's npm on PATH to build the client. Install Node.js, or publish with -p:SkipClientBuild=true after building the client by hand (npm run build in NektoTranslate.Client)." />

		<Exec Command="npm ci" WorkingDirectory="$(NektoClientDirectory)" Condition="!Exists('$(NektoClientDirectory)node_modules')" />
		<Exec Command="npm run build" WorkingDirectory="$(NektoClientDirectory)" />
	</Target>

	<!--
		"Content Include" for wwwroot, further up this file, is evaluated once when the project
		loads - before BuildClient above has written anything there on a first publish - so it
		never sees these files. Adding them to ResolvedFileToPublish here instead, after that list
		is computed and after the client has actually been built, is what gets them copied.

		Whether the SDK's own static-web-assets pass has already picked a file up depends on when
		wwwroot came to exist relative to project evaluation, and it lists what it found by full
		path. So the check for "already in the publish list" goes by each item's RelativePath, the
		one thing both sides agree on - matching by item spec let the same file in twice and failed
		the publish with NETSDK1152.
	-->
	<Target Name="IncludeClientBuildOutput" AfterTargets="ComputeFilesToPublish" DependsOnTargets="BuildClient">
		<ItemGroup>
			<NektoAlreadyPublished Include="@(ResolvedFileToPublish->'%(RelativePath)')" />
			<NektoClientBuildFiles Include="wwwroot\**" Condition="Exists('wwwroot')" />
			<NektoClientBuildFiles Remove="@(NektoAlreadyPublished)" />
			<ResolvedFileToPublish Include="@(NektoClientBuildFiles)">
				<RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
