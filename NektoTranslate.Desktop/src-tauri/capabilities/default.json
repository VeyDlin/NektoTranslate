{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. The window's own content is the loopback server (spawned or attached), which is why the same grant also covers it as a remote origin - Tauri treats any origin other than its own bundled one as remote, port and all, even though it is really just this application talking to itself.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://127.0.0.1:*/**", "http://localhost:*", "http://localhost:*/**"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-resize-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install",
    "allow-update-pending"
  ]
}
