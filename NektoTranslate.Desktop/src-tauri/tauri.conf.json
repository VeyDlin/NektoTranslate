  "productName": "NektoTranslate",
  "version": "0.1.0",
  "identifier": "com.veydlin.nektotranslate",
  "build": {
    "frontendDist": "frontend-stub"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
